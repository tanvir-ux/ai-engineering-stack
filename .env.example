# Copy to .env. Nothing here is required: the default is a deterministic fake model and local retrieval.
AISTACK_LLM_MODE=fake               # fake | openai | gemini
OPENAI_API_KEY=                     # for AISTACK_LLM_MODE=openai
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=                     # for AISTACK_LLM_MODE=gemini (OpenAI-compatible endpoint)
GEMINI_MODEL=gemini-2.5-flash
PINECONE_API_KEY=
PINECONE_INDEX=aistack-chunks
AISTACK_IDP_MODE=mock               # mock | external
AISTACK_OIDC_ISSUER=                # external IdP (Keycloak, Auth0, Entra ID), e.g. https://idp.example.com/realms/acme
AISTACK_OIDC_AUDIENCE=aistack-api
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=        # e.g. http://localhost:4318 to export traces
AISTACK_RATE_LIMIT_PER_MINUTE=30
