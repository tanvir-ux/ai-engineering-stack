# One image runs both the gateway (`aistack serve`) and the MCP tool server (`aistack mcp`).
FROM python:3.12-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN uv venv /opt/venv && VIRTUAL_ENV=/opt/venv uv pip install --no-cache .

FROM python:3.12-slim
RUN useradd --system --uid 10001 --create-home aistack && mkdir -p /data && chown aistack /data
COPY --from=build /opt/venv /opt/venv
WORKDIR /app
# Gold tables produced by the data layer. Rebuild them with `make data`.
COPY --chown=aistack artifacts/gold ./artifacts/gold
ENV PATH="/opt/venv/bin:$PATH" PYTHONUNBUFFERED=1 \
    AISTACK_GOLD_CHUNKS_PATH=/app/artifacts/gold/chunks.parquet \
    AISTACK_TICKETS_PATH=/app/artifacts/gold/tickets.parquet \
    AISTACK_CHECKPOINT_DB=/data/graph.sqlite
USER 10001
EXPOSE 8000 8001
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=5 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2).status == 200 else 1)" || exit 1
CMD ["aistack", "serve", "--host", "0.0.0.0", "--port", "8000"]
